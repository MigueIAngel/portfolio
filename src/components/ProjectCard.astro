---
import { Image } from 'astro:assets'
import type { Project } from '../data/projects'
import { type Lang, useTranslations } from '../i18n/ui'

interface Props {
  project: Project
  lang: Lang
}
const { project, lang } = Astro.props
const t = useTranslations(lang)
---

<article
  class:list={[
    'project reveal card group flex flex-col overflow-hidden transition hover:border-lime/50',
    project.featured && 'lg:col-span-2 lg:grid lg:grid-cols-2',
  ]}
  data-categories={project.categories.join(' ')}
>
  <div class="relative overflow-hidden border-b border-line bg-ink lg:border-b-0" class:list={[project.featured && 'lg:border-r']}>
    {
      project.image ? (
        <Image
          src={project.image}
          alt={project.name}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="aspect-[16/9] h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <pre class="flex aspect-[16/9] h-full items-center overflow-x-auto p-6 font-mono text-[12px] leading-5 text-slate-400"><code>{project.snippet}</code></pre>
      )
    }
    {
      project.featured && (
        <span class="absolute top-3 left-3 rounded-full bg-lime px-2.5 py-1 font-mono text-[11px] font-semibold text-ink">
          ★ {t('projects.featured')}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-semibold">{project.name}</h3>
    <p class="mt-3 text-slate-400">{project.description[lang]}</p>
    <ul class="mt-4 space-y-1.5 text-sm text-slate-400">
      {
        project.highlights.map((item) => (
          <li class="flex gap-2">
            <span class="text-lime">▸</span>
            {item[lang]}
          </li>
        ))
      }
    </ul>
    <div class="mt-5 flex flex-wrap gap-2">{project.stack.map((tech) => <span class="chip">{tech}</span>)}</div>
    <div class="mt-auto flex gap-4 pt-6 font-mono text-sm">
      <a href={project.repo} target="_blank" rel="noopener" class="text-white hover:text-lime">{t('projects.code')} ↗</a>
      {
        project.demo && (
          <a href={project.demo} target="_blank" rel="noopener" class="text-sky hover:text-lime">
            {t('projects.demo')} ↗
          </a>
        )
      }
    </div>
  </div>
</article>
