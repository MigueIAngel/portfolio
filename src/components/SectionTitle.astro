---
interface Props {
  index: string
  title: string
  subtitle?: string
}
const { index, title, subtitle } = Astro.props
---

<div class="reveal mb-12">
  <p class="section-label">{index}</p>
  <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 max-w-2xl text-slate-400">{subtitle}</p>}
</div>
