---
import { education, skills } from '../data/profile'
import { type Lang, useTranslations } from '../i18n/ui'
import SectionTitle from './SectionTitle.astro'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)
---

<section id="skills" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <SectionTitle index="04 / skills" title={t('skills.title')} />
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((group) => (
        <div class="reveal card p-6">
          <h3 class="font-mono text-sm text-lime">{group.title[lang]}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-lg bg-white/5 px-3 py-1.5 text-sm text-slate-200">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <h3 class="reveal mt-16 mb-6 text-2xl font-semibold">{t('education.title')}</h3>
  <div class="grid gap-4 md:grid-cols-3">
    {
      education.map((item) => (
        <div class="reveal card p-6">
          {item.year && <p class="font-mono text-xs text-slate-500">{item.year}</p>}
          <p class="mt-1 font-semibold text-white">{item.title[lang]}</p>
          <p class="mt-1 text-sm text-sky">{item.place}</p>
          {item.note && <p class="mt-2 text-sm text-slate-400">{item.note[lang]}</p>}
        </div>
      ))
    }
  </div>
</section>
