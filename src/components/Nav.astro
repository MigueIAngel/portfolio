---
import { type Lang, useTranslations } from '../i18n/ui'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const otherHref = lang === 'en' ? `${base}/es/` : `${base}/`
const links = [
  ['#about', t('nav.about')],
  ['#experience', t('nav.experience')],
  ['#projects', t('nav.projects')],
  ['#skills', t('nav.skills')],
  ['#contact', t('nav.contact')],
]
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-ink/70 backdrop-blur-md">
  <div id="hosting-banner" role="status" class="border-b border-lime/30 bg-lime/10">
    <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-2 text-xs text-slate-200 sm:px-6">
      <span aria-hidden="true">⏱</span>
      <p class="flex-1">
        {t('banner.text')}
        <a href="#projects" class="ml-1 font-semibold text-lime underline-offset-2 hover:underline">{t('nav.projects')} →</a>
      </p>
      <button
        type="button"
        id="hosting-banner-close"
        class="rounded px-2 text-base leading-none text-slate-400 hover:text-white"
        aria-label={t('banner.close')}
        title={t('banner.close')}
      >
        ×
      </button>
    </div>
  </div>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="#top" class="font-mono text-sm font-semibold text-white">
      <span class="text-lime">~/</span>miguel-altamar
    </a>
    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          links.map(([href, label]) => (
            <li>
              <a href={href} class="rounded-lg px-3 py-1.5 text-sm text-slate-400 transition hover:text-white">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={otherHref}
        hreflang={lang === 'en' ? 'es' : 'en'}
        class="ml-2 rounded-lg border border-line px-3 py-1.5 font-mono text-xs text-slate-300 transition hover:border-lime hover:text-lime"
      >
        {lang === 'en' ? 'ES' : 'EN'}
      </a>
    </div>
  </nav>
</header>

<script>
  // Dismissal is remembered per visitor; the banner still shows if storage is unavailable.
  const KEY = 'portfolio.hostingBannerDismissed'
  const banner = document.getElementById('hosting-banner')
  try {
    if (localStorage.getItem(KEY) === '1') banner?.remove()
  } catch {
    /* storage unavailable */
  }
  document.getElementById('hosting-banner-close')?.addEventListener('click', () => {
    banner?.remove()
    try {
      localStorage.setItem(KEY, '1')
    } catch {
      /* storage unavailable */
    }
  })
</script>
